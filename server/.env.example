# MongoDB Atlas Connection URI
MONGO_URI=your_mongodb_connection_string

# JSON Web Token Secret Key for signing tokens
JWT_SECRET=your_jwt_secret_key_here

# Express Server Port (Default: 5000, Render/Railway injects PORT automatically)
PORT=5000

# Environment mode (development / production)
NODE_ENV=production

# Frontend Client URL for CORS (Leave empty or set to your frontend domain like https://your-app.vercel.app)
CLIENT_URL=

