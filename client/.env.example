# Backend API base URL
# For local development with Vite:
VITE_API_URL=http://localhost:5000

# For production separate hosting (e.g. Vercel frontend + Render backend):
# VITE_API_URL=https://your-backend-api.onrender.com

# For production unified hosting (frontend served directly from Express server):
# Leave empty or set to /
# VITE_API_URL=

